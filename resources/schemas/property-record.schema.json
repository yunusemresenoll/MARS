{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars.local/schemas/property-record.schema.json",
  "title": "MARS Property Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "domain",
    "name_en",
    "name_tr",
    "definition",
    "canonical_unit",
    "value_kind",
    "spatial_scope",
    "temporal_behavior",
    "vertical_behavior",
    "allowed_statuses",
    "definition_sources"
  ],
  "properties": {
    "property_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]+$"},
    "domain": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "name_tr": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "canonical_unit": {"type": ["string", "null"]},
    "value_kind": {"enum": ["SCALAR", "VECTOR", "TENSOR", "CATEGORY", "BOOLEAN", "TEXT"]},
    "spatial_scope": {"enum": ["GLOBAL", "SPATIAL", "BOTH"]},
    "temporal_behavior": {"enum": ["TIME_INVARIANT", "TIME_DEPENDENT", "BOTH"]},
    "vertical_behavior": {"enum": ["NONE", "ALTITUDE", "DEPTH", "BOTH"]},
    "allowed_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["MEASURED", "DERIVED", "MODELLED", "UNKNOWN"]}
    },
    "definition_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
