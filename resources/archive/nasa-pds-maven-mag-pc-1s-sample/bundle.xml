        <title>MAVEN MAG Calibrated Data Bundle</title>
        <information_model_version>1.13.0.0</information_model_version>
        <product_class>Product_Bundle</product_class>
        <Citation_Information>
            <publication_year>2026</publication_year>
            <doi>10.17189/1414178</doi>
            <description>
                This bundle contains MAG supplied ASCII files containing a time series of 
                magnetic-field vectors in geophysical units (nanotesla, nT) that have been 
                corrected for instrumental and spacecraft effects (calibrated). In addition, 
                these data have been transformed into physically meaningful coordinate
                systems. MAG data products are generated for all mission phases.
            </description>
        </Citation_Information>
