
OBJECT               = COLUMN
  COLUMN_NUMBER      = 1
  NAME               = 1
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 1
  BYTES              = 1
  DESCRIPTION        = "A quality indicator:  0 means this record contains valid data"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 2
  NAME               = DATE
  DATA_TYPE          = CHARACTER
  START_BYTE         = 3
  BYTES              = 14
  DESCRIPTION        = "Date of profile (UTC)"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 3
  NAME               = UTC
  DATA_TYPE          = CHARACTER
  START_BYTE         = 18
  BYTES              = 15
  DESCRIPTION        = "Time of profile (UTC)"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 4
  NAME               = SCLK
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 34
  BYTES              = 15
  DESCRIPTION        = "The MRO Spacecraft Clock of profile, without 
    partition, including decimal thousandths of a second."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 5
  NAME               = L_S
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 50
  BYTES              = 10
  DESCRIPTION        = "Solar Longitude of Mars (deg)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 6
  NAME               = SOLAR_DIST
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 61
  BYTES              = 14
  DESCRIPTION        = "Distance from the center of Mars to the center 
    of the Sun (km)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 7
  NAME               = ORB_NUM
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 76
  BYTES              = 8
  DESCRIPTION        = "MRO Orbit Number."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 8
  NAME               = GQUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 85
  BYTES              = 6
  DESCRIPTION        = "Geometry quality:   
    0 = good.   
    1 = good, Phobos in view
    2 = good, Deimos in view
    3 = undetermined attitude information  
    4 = Pointing is incorrect and geometry is not fixed 
    5 = Pointing may be incorrect and geometry is not fixed 
    6 = Pointing is incorrect and geometry was fixed
    7 = Pointing is incorrect and geometry is not fixed, Phobos in view
    8 = Pointing may be incorrect and geometry is not fixed, Phobos in view
    9 = Pointing is incorrect and geometry was fixed, Phobos in view
    10 = Pointing is incorrect and geometry is not fixed, Deimos in view
    11 = Pointing may be incorrect and geometry is not fixed, Deimos in view
    12 = Pointing is incorrect and geometry was fixed, Deimos in view
    13 = good, solar array in view
    14 = Pointing is incorrect and geometry is not fixed, solar array in view
    15 = Pointing may be incorrect and geometry is not fixed, solar array in view
    16 = Pointing is incorrect and geometry was fixed, solar array in view"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 9
  NAME               = SOLAR_LAT
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 92
  BYTES              = 10
  DESCRIPTION        = "The Mars-centric north latitude of the Sun, in degrees"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 10
  NAME               = SOLAR_LON
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 103
  BYTES              = 10
  DESCRIPTION        = "The Mars-centric east longitude of the Sun, in degrees"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 11
  NAME               = SOLAR_ZEN
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 114
  BYTES              = 11
  DESCRIPTION        = "The angular separation, in degrees, between the vector from
    the center of Mars to the scene point (see below) and the vector from the center
    of Mars to the Sun"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 12
  NAME               = LTST
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 126
  BYTES              = 9
  DESCRIPTION        = "Mars Local True Solar Time of the profile in fraction of sol."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 13
  NAME               = PROFILE_LAT
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 136
  BYTES              = 12
  DESCRIPTION        = "Latitude of the center of the profile (deg), see the next section
    for the latitude of specific pressures."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 14
  NAME               = PROFILE_LON
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 149
  BYTES              = 12
  DESCRIPTION        = "Longitude of the center of the profile (deg), see the next section
    for the longitude of specific pressures."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 15
  NAME               = PROFILE_RAD
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 162
  BYTES              = 12
  DESCRIPTION        = "The distance, in kilometers, from the center of  Mars to the center
    of the profile."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 16
  NAME               = PROFILE_ALT
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 175
  BYTES              = 12
  DESCRIPTION        = "The distance, in kilometers, from the center of  the profile to the
    local MOLA elevation."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 17
  NAME               = LIMB_ANG
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 188
  BYTES              = 11
  DESCRIPTION        = "The angle, in degrees, between the local vertical and the MCS arrays
    during the observations for the profile."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 18
  NAME               = ARE_RAD
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 200
  BYTES              = 9
  DESCRIPTION        = "MOLA areoid radius at the center point of the profile (km)"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 19
  NAME               = SURF_LAT
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 210
  BYTES              = 10
  DESCRIPTION        = "Latitude of the surface point for the profile, or if there is no
    surface sounding (see column 46, SURF_QUAL) the latitude of the tangent point for the
    lowest line-of-sight that does not intersect the surface (deg)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 20
  NAME               = SURF_LON
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 221
  BYTES              = 11
  DESCRIPTION        = "Longitude of the surface point for the profile, or if there is no
    surface sounding (see column 46, SURF_QUAL) the longitude of the tangent point for the
    lowest line-of-sight that does not intersect the surface (deg)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 21
  NAME               = SURF_RAD
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 233
  BYTES              = 10
  DESCRIPTION        = "The distance, in kilometers, from the center of Mars to the surface
    point.  If there is no surface sounding (see column 46, SURF_QUAL), this is the distance
    from the center of Mars to the tangent point for the lowest line-of-sight that does not
    intersect the surface.  In either case, this is also the radius of the altitude grid for 
    the profile."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 22
  NAME               = T_SURF
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 244
  BYTES              = 9
  DESCRIPTION        = "Surface temperature (K)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 23
  NAME               = T_SURF_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 254
  BYTES              = 11
  DESCRIPTION        = "Surface temperature uncertainty (K)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 24
  NAME               = T_NEAR_SURF
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 266
  BYTES              = 12
  DESCRIPTION        = "Near surface atmospheric temperature (K)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 25
  NAME               = T_NEAR_SURF_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 279
  BYTES              = 16
  DESCRIPTION        = "Near surface atmospheric temperature uncertainty (K)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 26
  NAME               = DUST_COLUMN
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 296
  BYTES              = 12
  DESCRIPTION        = "Dust column opacity at 463 wavenumbers (or 21.6 microns)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 27
  NAME               = DUST_COLUMN_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 309
  BYTES              = 16
  DESCRIPTION        = "Dust column opacity uncertainty at 463 wavenumbers
    (or 21.6 microns)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 28
  NAME               = H2OVAP_COLUMN
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 326
  BYTES              = 15
  DESCRIPTION        = "Water vapor column amount (precipitable-microns, pr-micron)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 29
  NAME               = H2OVAP_COLUMN_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 342
  BYTES              = 19
  DESCRIPTION        = "Water vapor column amount uncertainty precipitable-microns,
    pr-micron)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 30
  NAME               = H2OICE_COLUMN
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 362
  BYTES              = 15
  DESCRIPTION        = "Water ice column opacity at 843 wavenumbers (or 11.9 microns)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 31
  NAME               = H2OICE_COLUMN_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 378
  BYTES              = 19
  DESCRIPTION        = "Water ice column opacity uncertainty at 843  wavenumbers
    (or 11.9 microns)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 32
  NAME               = CO2ICE_COLUMN
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 398
  BYTES              = 15
  DESCRIPTION        = "CO2 ice column opacity at 607 wavenumbers (or 16.5 microns)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 33
  NAME               = CO2ICE_COLUMN_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 414
  BYTES              = 19
  DESCRIPTION        = "CO2 ice column opacity uncertainty at 607 wavenumbers 
    (or 16.5 microns)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 34
  NAME               = P_SURF
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 434
  BYTES              = 9
  DESCRIPTION        = "Surface pressure (Pa); 100 Pa = 1 mBar"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 35
  NAME               = P_SURF_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 444
  BYTES              = 13
  DESCRIPTION        = "Surface pressure uncertainty (Pa); 100 Pa = 1 mBar"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 36
  NAME               = P_RET_ALT
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 458
  BYTES              = 10
  DESCRIPTION        = "Altitude above the 'surface' (column 21) at which pressure is 
    retrieved (km)."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 37
  NAME               = P_RET
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 469
  BYTES              = 11
  DESCRIPTION        = "Retrieved pressure (Pa)"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 38
  NAME               = P_RET_ERR
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 481
  BYTES              = 10
  DESCRIPTION        = "Retrieved pressure uncertainty (Pa)"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 39
  NAME               = RQUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 492
  BYTES              = 6
  DESCRIPTION        = "Radiance Quality Flag"
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 40
  NAME               = P_QUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 499
  BYTES              = 7
  DESCRIPTION        = "Pressure retrieval quality flag.
    0 = successful pressure retrieval.
    9 = pressure not retrieved, pressure scale is based on climatological surface pressure."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 41
  NAME               = T_QUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 507
  BYTES              = 7
  DESCRIPTION        = "Temperature retrieval quality flag.
    0 = successful limb/nadir retrieval, surface temperature reported.
    1 = truncated limb/nadir retrieval, surface temperature reported.
    2 = truncated limb/nadir retrieval, no surface temperature reported.
    3 = successful limb retrieval.
    4 = truncated limb retrieval."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 42
  NAME               = DUST_QUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 515
  BYTES              = 10
  DESCRIPTION        = "Dust retrieval quality flag.
    0 = dust retrieval using A,B channels, column reported.
    1 = dust retrieval using A channel, column reported.
    2 = dust retrieval using A,B channels, column reported, column error corrected.
    3 = dust retrieval using A channel, column reported, column error corrected.
    4 = dust retrieval using A,B channels, no column reported.
    5 = dust retrieval using A channel, no column reported.
    9 = dust not retrieved."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 43
  NAME               = H2OVAP_QUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 526
  BYTES              = 13
  DESCRIPTION        = "Water vapor retrieval quality flag.
    9 = not retrieved."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 44
  NAME               = H2OICE_QUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 540
  BYTES              = 13
  DESCRIPTION        = "Water ice retrieval quality flag.
    0 - water ice retrieval using A,B channels, column reported.
    1 = water ice retrieval using A channel, column reported.
    2 = not used.
    3 = not used.
    4 - water ice retrieval using A,B channels, no column reported.
    5 - water ice retrieval using A channel, no column reported.
    9 = water ice not retrieved."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 45
  NAME               = CO2ICE_QUAL
  DATA_TYPE          = ASCII_INTEGER
  START_BYTE         = 554
  BYTES              = 13
  DESCRIPTION        = "CO2 ice retrieval quality flag.
    9 = not retrieved."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 46
  NAME               = SURF_QUAL
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 568
  BYTES              = 10
  DESCRIPTION        = "Surface/near surface retrieval quality flag.
    0 = surface temperature and near-surface atmospheric temperature reported, view angle within 30 deg of nadir.
    1 = surface temperature reported, view angle within 30 deg of nadir.
    2 = surface temperature and near-surface atmospheric temperature reported, view angle larger than 30 from nadir.
    3 = surface temperature reported, view angle larger than 30 from nadir.
    9 = surface quantities not reported."
END_OBJECT           = COLUMN

OBJECT               = COLUMN
  COLUMN_NUMBER      = 47
  NAME               = OBS_QUAL
  DATA_TYPE          = ASCII_REAL
  START_BYTE         = 579
  BYTES              = 10
  DESCRIPTION        = "Quality and viewing direction of the observations used for the retrieval.
    0 = Standard observations, forward in-track viewing (178 deg <= Azimuth <= 182 deg), retrieved in 1-D.
    1 = Limb staring observations (reduced calibration quality), forward in-track viewing (178 <= Azimuth <= 182 deg), retrieved in 1-D.
    2 = Standard observations, right forward off-track viewing (182 deg < Azimuth < 260 deg), retrieved in 1-D.
    3 = Standard observations, right cross-track viewing (260 deg <= Azimuth < 290 deg), retrieved in 1-D.
    4 = Standard observations, left forward off-track viewing (90 deg < Azimuth < 178 deg), retrieved in 1-D.
    5 = Standard observations, left cross-track viewing (Azimuth = 90 deg), retrieved in 1-D.
    6 = Standard observations, left aft off-track viewing (2 deg < Azimuth < 90 deg), retrieved in 1-D.
    7 = Standard observations, aft in-track viewing (-4 deg <= Azimuth <= 2 deg), retrieved in 1-D.
   10 = Standard observations, forward in-track viewing (178 deg <= Azimuth <= 182 deg), retrieved in 2-D.
   11 = Limb staring observations (reduced calibration quality), forward in-track viewing (178 <= Azimuth <= 182 deg), retrieved in 2-D.
   17 = Standard observations, aft in-track viewing (-4 deg <= Azimuth <= 2 deg), retrieved in 2-D."
END_OBJECT           = COLUMN

