 OBJECT                           = DATA_SET_INFORMATION
  DATA_SET_NAME                  = "MRO MARS CLIMATE SOUNDER LEVEL 5 
                                     DDR V6.2"
  DATA_SET_TERSE_DESC            = "The MCS atmospheric profiler detects
       vertical variations of temperature, dust, water ice, and water vapor
       concentrations in the Martian atmosphere. Derived Data Records 
       (DDRs) in the form of Level 2 data products (retrieved geophysical 
       profiles) are generated from the RDRs"
